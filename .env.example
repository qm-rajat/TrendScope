# ==============================================================================
# TrendScope - Environment Variables
# ==============================================================================

# GETXAPI_API_KEY: API key for GetXAPI Twitter/X Trends service (https://getxapi.com)
# Kept strictly server-side in API route handlers. If empty, the app defaults to realistic Demo mode.
GETXAPI_API_KEY=""

# GEMINI_API_KEY: Optional key for Gemini AI capabilities.
GEMINI_API_KEY=""

# APP_URL: Optional root application URL. Vercel automatically sets VERCEL_URL.
APP_URL=""


